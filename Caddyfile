# TLS for the Relay node. RELAY_HOSTNAME=relay.relayagents.dev gets a public cert; a tailnet name
# (e.g. relay.tail1234.ts.net) works with `tailscale cert` files mounted and `tls` pointed at them.
{$RELAY_HOSTNAME:localhost} {
	encode gzip

	# Uploads are capped here and again in relay-api (RELAY_MAX_UPLOAD_MB); keep the two in sync.
	request_body {
		max_size {$RELAY_MAX_UPLOAD_MB:512}MB
	}

	handle_path /workspace-mcp/* {
		reverse_proxy workspace-mcp:8000
	}

	handle {
		reverse_proxy relay-api:8000 {
			# MCP streamable HTTP and long-poll inboxes hold connections open.
			transport http {
				read_timeout 0
				write_timeout 0
			}
		}
	}
}
