# ---- Relay node -------------------------------------------------------------------------------
# Copy to .env. Never commit .env. scripts/bootstrap.sh fills the generated values for you.
RELAY_HOSTNAME=relay.relayagents.dev        # or a tailnet name; Caddy gets the cert
RELAY_PUBLIC_URL=https://relay.relayagents.dev
RELAY_TEAM_NAME=relay
RELAY_ENVIRONMENT=prod
RELAY_LOG_LEVEL=INFO
RELAY_BIND_IP=127.0.0.1                     # Postgres/Redis bind; set to the node's Tailscale IP for a remote GPU worker

POSTGRES_PASSWORD=change-me                 # generated by bootstrap.sh
RELAY_TOKEN_PEPPER=change-me                # generated by bootstrap.sh; rotating it revokes every token

# ---- Team memory ------------------------------------------------------------------------------
RELAY_MEMORY_BACKEND=graphiti-kuzu          # graphiti-kuzu | none
# Extraction/embedding model, workers only. 'keyword' needs no key (deterministic cue phrases).
RELAY_EXTRACTION_MODEL=keyword              # e.g. openai:gpt-5-mini or anthropic:claude-sonnet-5
RELAY_EMBEDDING_MODEL=openai:text-embedding-3-small
TEAM_OPENAI_API_KEY=                        # the TEAM key for workers; user agents never use it
TEAM_ANTHROPIC_API_KEY=

# ---- Transcription ----------------------------------------------------------------------------
RELAY_TRANSCRIBER=whisperx                  # whisperx | fixture
RELAY_WHISPERX_MODEL=small                  # CPU fallback default; large-v3 on the GPU worker
HF_TOKEN=                                   # Hugging Face token for pyannote diarization (gated models)

# ---- Slack (one app, Socket Mode, no public URL) ---------------------------------------------
# Scopes: chat:write, im:write, users:read, app_mentions:read. Enable Socket Mode + Interactivity.
SLACK_BOT_TOKEN=xoxb-...
SLACK_APP_TOKEN=xapp-...
SLACK_TEAM_CHANNEL=C0123456789              # channel id for meeting summaries and digests

# ---- Google Workspace (workspace-mcp, per-user OAuth) ----------------------------------------
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# ---- Images -----------------------------------------------------------------------------------
RELAY_IMAGE=ghcr.io/relayagents/relay:latest
RELAY_INGEST_IMAGE=ghcr.io/relayagents/relay-ingest:latest
RELAY_SANDBOX_IMAGE=ghcr.io/relayagents/relay-sandbox:latest
WORKSPACE_MCP_IMAGE=ghcr.io/taylorwilsdon/google_workspace_mcp:latest
